# =========================================================
# VARIÁVEIS DE AMBIENTE — Despertar ParaPSI
# =========================================================
# Este é um MODELO. As variáveis de verdade ficam na
# Cloudflare Pages (Settings > Environment variables).
# NUNCA coloque valores reais neste arquivo nem no GitHub.
#
# O site é estático e funciona sem nada disso preenchido —
# estas variáveis apenas LIGAM os recursos extras.
# Observação: variáveis que começam com NEXT_PUBLIC_ ficam
# visíveis no navegador (é o esperado para um site estático).
# =========================================================

# --- Formulário: planilha do Google + e-mail (Apps Script) ---
# Endereço do Web App do Apps Script. Ele grava o lead na
# planilha E envia o e-mail para o Marco (ver MANUTENCAO.md).
NEXT_PUBLIC_PLANILHA_WEBHOOK_URL=

# --- Analytics (só carregam após consentimento de cookies) ---
# Google Analytics 4 (ex.: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Meta/Facebook Pixel (ex.: 123456789012345)
NEXT_PUBLIC_META_PIXEL_ID=
# Microsoft Clarity — mapas de calor e gravação de sessões (ex.: abcdef1234)
NEXT_PUBLIC_CLARITY_ID=
