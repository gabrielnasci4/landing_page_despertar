# =========================================================
# VARIÁVEIS DE AMBIENTE — Despertar PΨ
# =========================================================
# Este é um MODELO. Copie o conteúdo para dentro da Vercel
# (Project Settings > Environment Variables). NUNCA coloque as
# chaves de verdade neste arquivo nem no GitHub.
#
# O site funciona sem nada disso preenchido — estas variáveis
# apenas LIGAM os recursos extras (e-mail do lead, planilha,
# analytics). Preencha quando cada recurso for configurado.
# =========================================================

# --- Formulário: e-mail do lead (Resend) ---
# Crie conta grátis em https://resend.com e gere uma API key.
RESEND_API_KEY=
# E-mail que RECEBE os contatos (ex.: o e-mail do Marco).
CONTATO_EMAIL_DESTINO=despertarparapsi@gmail.com
# Remetente verificado no Resend (ex.: contato@seudominio.com.br).
CONTATO_EMAIL_REMETENTE=

# --- Formulário: planilha do Google (Apps Script) ---
# Endereço do Web App do Apps Script (ver MANUTENCAO.md).
PLANILHA_WEBHOOK_URL=

# --- Analytics (só carregam após consentimento de cookies) ---
# Google Analytics 4 (ex.: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
# Meta/Facebook Pixel (ex.: 123456789012345)
NEXT_PUBLIC_META_PIXEL_ID=
